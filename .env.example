# ── App ─────────────────────────────────────────────
DEBUG=true

# ── Database (PostgreSQL) ───────────────────────────
# createdb remory && createuser remory  후 아래 URL 맞추세요
DATABASE_URL=postgresql+psycopg2://remory:remory@localhost:5432/remory

# ── JWT ─────────────────────────────────────────────
# 운영에서는 반드시 랜덤 값으로 교체: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=dev-only-change-me-in-production-0000000000
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
REGISTER_TOKEN_TTL_MIN=10

# ── WebAuthn (패스키) ────────────────────────────────
RP_ID=remory.app
RP_NAME=ReMory
# 허용 origin. iOS는 associated domain(https://<rp_id>),
# Android는 apk-key-hash(android:apk-key-hash:xxxx), 웹 개발은 http://localhost
WEBAUTHN_ORIGINS=["https://remory.app","http://localhost"]

# ── 실기기 패스키 테스트용 앱-도메인 연결 ────────────
# rp_id 도메인(ngrok 고정 도메인 등)이 아래 값으로 .well-known 파일을 서빙한다.
# iOS: "팀ID.번들ID" (예: ABCDE12345.com.remory.app)
IOS_APP_IDS=[]
# Android: 패키지명 + 서명 인증서 SHA-256 지문
#   지문 확인: keytool -list -v -keystore ~/.android/debug.keystore \
#             -alias androiddebugkey -storepass android -keypass android
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=[]

# ── 전화번호 인증(OTP) ───────────────────────────────
OTP_TTL_SEC=180
OTP_MAX_ATTEMPTS=5

# ── 인형(Device) ────────────────────────────────────
# 마지막 heartbeat 이후 이 시간이 지나면 '연결 끊김'으로 표시
DEVICE_OFFLINE_AFTER_SEC=600
# 완충 시 예상 사용 시간(배터리 잔여 시간 계산용)
DEVICE_BATTERY_FULL_HOURS=18

# ── 서비스 정보 (GET /service/info) ──────────────────
SERVICE_VERSION=1.0.2
SERVICE_MIN_SUPPORTED_VERSION=1.0.0
TERMS_URL=https://remory.app/terms
PRIVACY_URL=https://remory.app/privacy
SUPPORT_EMAIL=support@remory.app
SUPPORT_PHONE=

# ── 알림 생성 조절 ──────────────────────────────────
# 부정 감정이 몇 번 연달아 기록되면 긴급 알림을 만들지.
EMOTION_ALERT_STREAK=3
# 같은 사건 알림을 이 시간 안에는 다시 만들지 않는다(분).
EMOTION_ALERT_COOLDOWN_MIN=60
CHAT_ALERT_COOLDOWN_MIN=10
RECONNECT_ALERT_COOLDOWN_MIN=30

# ── 리포트 문구 생성(Groq) ──────────────────────────
# 데일리 리포트의 요약·제안 문장을 모델이 쓴다.
# 비워 두면 규칙 기반 문구로 물러나고 제안은 비어 있다(배치는 그대로 돈다).
GROQ_API_KEY=
# 계정마다 쓸 수 있는 모델이 다르다. `client.models.list()` 로 확인할 것.
# 한국어 문구는 qwen 계열이 가장 자연스러웠고 응답도 빨랐다(0.4초).
# 대안: openai/gpt-oss-120b (1.2초, 문장이 조금 딱딱함)
LLM_MODEL=qwen/qwen3.8-27b
# 모델을 한 번 부르고 이만큼 쉰다(초). 무료 등급은 분당 출력 토큰 한도가 있어
# 잇따라 부르면 뒤엣것이 429 로 막히고, 그 사람 리포트만 규칙 기반 문구가 된다.
# 리포트는 밤에 도는 배치라 빨리 끝날 이유가 없다. 등급을 올렸으면 0 으로 둔다.
LLM_MIN_GAP_SEC=65

# ── 가족 초대 코드 ──────────────────────────────────
# 발급한 코드가 며칠 뒤 만료되는지.
INVITE_CODE_TTL_HOURS=24

# ── 업로드 저장소: local | s3 ───────────────────────
# 컨테이너 배포는 재시작하면 로컬 디스크가 사라지므로 운영은 s3 를 쓴다.
STORAGE_BACKEND=local
S3_BUCKET=
# 버킷이 있는 리전. 다르면 presigned URL 이 엉뚱한 엔드포인트로 발급된다.
S3_REGION=us-west-2
# 버킷 안 상위 폴더(예: prod). 비우면 버킷 루트에 올린다.
S3_KEY_PREFIX=
# CloudFront·커스텀 도메인을 앞에 둘 때만 채운다.
# 비우면 https://<버킷>.s3.<리전>.amazonaws.com 을 쓴다.
# S3_PRESIGN 과 같이 쓸 수 없다(presigned 서명은 S3 엔드포인트에만 유효).
S3_PUBLIC_BASE_URL=
# 버킷을 비공개로 두고 조회 응답에만 만료되는 URL 을 내려준다(권장).
# false 로 두면 버킷을 퍼블릭 읽기로 열어야 앱이 사진·음성을 받을 수 있다.
S3_PRESIGN=true
S3_PRESIGN_TTL_SEC=3600
# 자격증명은 boto3 기본 체인을 따른다.
# EC2 인스턴스 역할에 S3 권한을 붙이면 아래 키는 필요 없다.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Firebase 전화번호 인증 ──────────────────────────
# 앱이 Firebase 로 인증번호를 받고, 서버는 그 ID 토큰만 검증한다.
# 문자를 구글이 보내므로 발신번호 등록·사업자등록이 필요 없다(무료 3,000건/일).
# 서비스 계정 키는 필요 없다 — 공개키로 서명 검증만 하므로 프로젝트 ID 하나면 된다.
# 비우면 POST /auth/phone/verify-firebase 가 401 을 낸다.
FIREBASE_PROJECT_ID=

# ── FCM 푸시 발송 ───────────────────────────────────
# 알림을 만들 때 보호자 폰으로 푸시를 보낸다. 발송은 ID 토큰 검증과 달리
# 공개키로 안 되고 서비스 계정 키가 있어야 한다.
#   Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
# 아래 둘 다 비워 두면 푸시를 보내지 않고 알림만 쌓인다(개발 기본값).
# 파일 경로를 먼저 보고, 없으면 JSON 내용을 그대로 읽는다.
# ⚠️ 이 키는 프로젝트에 메시지를 보낼 수 있다. 레포에 커밋하지 말 것.
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=

# ── Fish Audio 보이스 클로닝 ─────────────────────────
# 녹음본으로 Fish Audio 에 비공개 목소리 모델을 만든다(https://fish.audio 에서 키 발급).
# 비우면 등록을 건너뛴다(녹음만 받고 training 상태 유지 — 데모).
# ⚠️ 과금되는 키다. 레포에 커밋하지 말 것.
FISH_API_KEY=
FISH_TIMEOUT_SEC=60

# ── SMS provider: mock | solapi | aligo | ncp ───────
# 아래는 서버가 직접 문자를 보내는 경로(발신번호 등록 필요).
# Firebase 를 쓰면 없어도 된다.
# mock 은 실제로 보내지 않고 서버 로그에만 찍는다.
SMS_PROVIDER=mock
# 사전 등록된 발신번호. 등록 안 된 번호로는 어느 제공자든 발송이 거부된다.
SMS_SENDER_NUMBER=

# 솔라피(구 CoolSMS). 공식 파이썬 SDK 를 쓴다.
# 잔액 조회로 키를 확인할 수 있어 문자를 안 보내고도 설정을 검증할 수 있다:
#   python scripts/send_test_sms.py --check
SOLAPI_API_KEY=
SOLAPI_API_SECRET=

# 알리고(Aligo)
ALIGO_API_KEY=
ALIGO_USER_ID=
# true 면 실제 발송·과금 없이 요청만 검증한다. 설정을 처음 맞출 때 쓴다.
ALIGO_TEST_MODE=false

# 네이버 클라우드 SENS
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_SERVICE_ID=

# 테스트용 번호(JSON 배열). 여기 적힌 번호는 문자를 보내지 않고 응답의
# testCode 에 인증번호를 담아 준다. 발신번호 심사를 기다리는 동안 실기기
# 테스트·시연을 돌리기 위한 것이다.
# ⚠️ 적힌 번호는 누구나 코드를 받아갈 수 있다. 팀이 가진 번호만 적고,
#    실사용자가 붙기 전에 반드시 비울 것.
OTP_TEST_PHONE_NUMBERS=[]

# 인증번호 재발송 제한(같은 번호 기준).
# /auth/phone/verification-code 는 인증 없이 열려 있고 실제 발송은 건당
# 요금이 나간다. 막지 않으면 잔액이 그대로 샌다.
OTP_SEND_COOLDOWN_SEC=60
OTP_SEND_MAX_PER_HOUR=5
